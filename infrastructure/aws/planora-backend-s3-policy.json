{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOnlyApplicationPrefixes",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::${PLANORA_PROFILE_BUCKET}", "arn:aws:s3:::${PLANORA_DOCUMENT_BUCKET}", "arn:aws:s3:::${PLANORA_CHAT_BUCKET}", "arn:aws:s3:::${PLANORA_TASK_BUCKET}"],
      "Condition": {"StringLike": {"s3:prefix": ["profiles/*", "documents/*", "chat/*", "tasks/*", "task-*/*"]}}
    },
    {
      "Sid": "PrivateObjectAccess",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:AbortMultipartUpload"],
      "Resource": [
        "arn:aws:s3:::${PLANORA_PROFILE_BUCKET}/*",
        "arn:aws:s3:::${PLANORA_DOCUMENT_BUCKET}/documents/*",
        "arn:aws:s3:::${PLANORA_CHAT_BUCKET}/chat/*",
        "arn:aws:s3:::${PLANORA_TASK_BUCKET}/task-*/*"
      ]
    }
  ]
}
