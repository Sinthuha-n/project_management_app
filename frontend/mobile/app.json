{
  "expo": {
    "name": "Planora",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "planora",
      "mobile"
    ],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.planora.mobile",
      "associatedDomains": [
        "applinks:planora.app"
      ],
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Planora uses your photo library so you can update your profile photo.",
        "NSUserNotificationsUsageDescription": "Planora sends project, task, chat, and invite notifications."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "package": "com.planora.mobile",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "planora.app"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#155DFC",
          "dark": {
            "backgroundColor": "#155DFC"
          }
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-notifications"
    ],
    "notification": {
      "icon": "./assets/images/android-icon-monochrome.png",
      "color": "#155DFC",
      "androidMode": "default",
      "androidCollapsedTitle": "Planora"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9089f91b-e94a-40c7-b517-7f5b627e52aa"
      }
    }
  }
}
